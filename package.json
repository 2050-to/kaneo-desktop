{
  "name": "kaneo-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop client for Kaneo",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm typecheck && pnpm lint && pnpm rust:fmt && pnpm rust:lint && pnpm rust:test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.5.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
