{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaneo Desktop",
  "version": "0.1.0",
  "identifier": "app.kaneo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kaneo Desktop",
        "width": 880,
        "height": 720,
        "minWidth": 520,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Desktop client for Kaneo",
    "longDescription": "Native window for your Kaneo instance — Kaneo Cloud or self-hosted.",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
